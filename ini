<title>La Cuenta Final</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsqr/1.4.0/jsQR.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
  /* ---- Deliberate single dark world: this is a camera-viewfinder tool.
     Native camera apps stay dark regardless of system theme, so this page
     commits to one palette and paints every color explicitly. ---- */
  :root{
    --ink:#0e141b;
    --surface:#182129;
    --surface-2:#212c36;
    --surface-3:#2a3644;
    --border:#324152;
    --text:#eef3f7;
    --text-muted:#8fa1b3;
    --accent:#ff7a45;
    --accent-strong:#ffa06e;
    --accent-ink:#3a1a0c;
    --success:#4ade80;
    --success-ink:#0d2416;
    --warn:#fbbf24;
    --warn-ink:#3a2c05;
    --danger:#f87171;
    --shadow: 0 20px 50px -20px rgba(0,0,0,0.6);
    --radius-lg: 22px;
    --radius-md: 14px;
    --radius-sm: 9px;
    --font-display:'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif;
    --font-body:'Manrope', 'Segoe UI', system-ui, sans-serif;
    --font-mono:'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  }

  *,*::before,*::after{ box-sizing:border-box; }
  html,body{
    background:var(--ink);
    color:var(--text);
    font-family:var(--font-body);
    -webkit-tap-highlight-color:transparent;
  }
  body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    padding:0;
    overflow-x:hidden;
  }
  h1,h2,h3{ font-family:var(--font-display); text-wrap:balance; margin:0; }
  p{ margin:0; }
  button{ font-family:inherit; }
  ::selection{ background:var(--accent); color:var(--accent-ink); }

  :focus-visible{
    outline:2px solid var(--accent-strong);
    outline-offset:2px;
  }

  .app{
    width:100%;
    max-width:480px;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    background:
      radial-gradient(120% 60% at 50% -10%, rgba(255,122,69,0.10), transparent 60%),
      var(--ink);
    position:relative;
  }

  /* ---------- top bar ---------- */
  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:18px 20px 10px;
  }
  .brand{ display:flex; flex-direction:column; gap:1px; }
  .brand .eyebrow{
    font-family:var(--font-mono);
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--accent-strong);
  }
  .brand h1{ font-size:20px; font-weight:700; letter-spacing:-0.01em; }
  .icon-btn{
    width:40px; height:40px;
    border-radius:50%;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--text-muted);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    transition:border-color .15s ease, color .15s ease;
    flex:none;
  }
  .icon-btn:hover{ border-color:var(--accent); color:var(--accent-strong); }
  .icon-btn svg{ width:18px; height:18px; }

  main{ flex:1; display:flex; flex-direction:column; padding:6px 20px 32px; gap:18px; }

  /* ---------- screens ---------- */
  .screen{ display:none; flex-direction:column; gap:18px; }
  .screen.is-active{ display:flex; }
  @media (prefers-reduced-motion: no-preference){
    .screen.is-active{ animation: fade-up .38s ease both; }
  }
  @keyframes fade-up{
    from{ opacity:0; transform:translateY(10px); }
    to{ opacity:1; transform:translateY(0); }
  }

  /* ---------- cards / fields ---------- */
  .card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-lg);
    padding:20px;
    display:flex;
    flex-direction:column;
    gap:14px;
    box-shadow:var(--shadow);
  }
  .card h2{ font-size:17px; }
  .field{ display:flex; flex-direction:column; gap:7px; }
  .field label{
    font-size:12px;
    font-weight:700;
    letter-spacing:0.04em;
    text-transform:uppercase;
    color:var(--text-muted);
  }
  .hint{ font-size:13px; color:var(--text-muted); line-height:1.5; }
  input[type="number"], input[type="text"], textarea{
    width:100%;
    background:var(--surface-2);
    border:1px solid var(--border);
    color:var(--text);
    border-radius:var(--radius-sm);
    padding:12px 14px;
    font-size:16px;
    font-family:var(--font-body);
  }
  input:focus, textarea:focus{ border-color:var(--accent); }

  .photo-strip{ display:flex; gap:8px; overflow-x:auto; padding-bottom:2px; }
  .photo-thumb{
    width:56px; height:56px; border-radius:10px; object-fit:cover;
    border:2px solid var(--border); cursor:pointer; flex:none;
    transition:border-color .15s ease, transform .12s ease;
  }
  .photo-thumb:hover{ transform:scale(1.04); }
  .photo-thumb.is-current{ border-color:var(--accent); box-shadow:0 0 0 2px rgba(255,122,69,0.35); }

  .btn{
    appearance:none; border:none; border-radius:999px;
    padding:14px 22px; font-size:15px; font-weight:700; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    transition:transform .12s ease, filter .15s ease, background .15s ease;
  }
  .btn:active{ transform:scale(0.97); }
  .btn-primary{ background:var(--accent); color:var(--accent-ink); }
  .btn-primary:hover{ filter:brightness(1.08); }
  .btn-ghost{ background:var(--surface-2); color:var(--text); border:1px solid var(--border); }
  .btn-ghost:hover{ border-color:var(--accent); }
  .btn-sm{ padding:9px 16px; font-size:13px; }
  .btn-block{ width:100%; }
  .btn[disabled]{ opacity:0.45; cursor:not-allowed; }

  /* ---------- roster editor ---------- */
  .roster-row{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:10px 0; border-bottom:1px solid var(--border);
  }
  .roster-row:last-child{ border-bottom:none; }
  .roster-name{ font-weight:600; font-size:15px; }
  .roster-name.is-inactive{ color:var(--text-muted); text-decoration:line-through; }
  .roster-actions{ display:flex; align-items:center; gap:12px; }
  .roster-status{
    font-family:var(--font-mono); font-size:10px; letter-spacing:0.06em;
    text-transform:uppercase; color:var(--text-muted); min-width:52px; text-align:right;
  }
  .roster-remove{
    background:none; border:none; color:var(--text-muted);
    font-size:18px; line-height:1; cursor:pointer; padding:4px;
  }
  .roster-remove:hover{ color:var(--danger); }
  .add-player{ display:flex; gap:8px; margin-top:4px; }
  .add-player input{ flex:1; }

  .switch{ position:relative; display:inline-flex; align-items:center; cursor:pointer; }
  .switch input{ position:absolute; opacity:0; inset:0; width:100%; height:100%; margin:0; cursor:pointer; }
  .switch-track{
    width:42px; height:24px; background:var(--surface-3);
    border:1px solid var(--border); border-radius:999px; position:relative;
    transition:background .15s ease, border-color .15s ease; flex:none;
  }
  .switch-thumb{
    position:absolute; top:2px; left:2px; width:18px; height:18px;
    border-radius:50%; background:var(--text-muted);
    transition:transform .15s ease, background .15s ease;
  }
  .switch input:checked ~ .switch-track{ background:rgba(74,222,128,0.18); border-color:var(--success); }
  .switch input:checked ~ .switch-track .switch-thumb{ transform:translateX(18px); background:var(--success); }
  .switch input:focus-visible ~ .switch-track{ outline:2px solid var(--accent-strong); outline-offset:2px; }

  /* ---------- scan progress chips ---------- */
  .progress-head{ display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
  .progress-count{ font-family:var(--font-mono); font-size:15px; color:var(--text-muted); font-variant-numeric: tabular-nums; }
  .progress-count b{ color:var(--text); font-size:17px; }
  .chip-wrap{ display:flex; flex-wrap:wrap; gap:8px; }
  .chip{
    appearance:none; border-radius:999px; padding:8px 14px; font-size:13px; font-weight:700;
    font-family:var(--font-body); border:1.5px solid var(--border);
    background:var(--surface-2); color:var(--text-muted); cursor:pointer; transition:all .12s ease;
  }
  .chip.is-pending:hover{ border-color:var(--accent); color:var(--text); }
  .chip.is-done{ background:var(--success); border-color:var(--success); color:var(--success-ink); }

  /* ---------- scanner ---------- */
  .scan-stage{
    position:relative; border-radius:var(--radius-lg); overflow:hidden;
    background:#000; aspect-ratio: 3 / 4; border:1px solid var(--border); box-shadow:var(--shadow);
  }
  .scan-stage video{ width:100%; height:100%; object-fit:cover; display:block; }
  .scan-frame{ position:absolute; inset:12%; border-radius:18px; pointer-events:none; }
  .scan-frame{
    background:
      linear-gradient(var(--accent-strong),var(--accent-strong)) 0 0/26px 3px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 0 0/3px 26px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 100% 0/26px 3px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 100% 0/3px 26px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 0 100%/26px 3px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 0 100%/3px 26px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 100% 100%/26px 3px no-repeat,
      linear-gradient(var(--accent-strong),var(--accent-strong)) 100% 100%/3px 26px no-repeat;
  }
  .scan-line{
    position:absolute; left:12%; right:12%; top:12%; height:2px;
    background:linear-gradient(90deg, transparent, var(--accent), transparent); opacity:0.9;
  }
  @media (prefers-reduced-motion: no-preference){ .scan-line{ animation: sweep 2.4s ease-in-out infinite; } }
  @keyframes sweep{ 0%,100%{ top:12%; } 50%{ top:84%; } }
  .scan-overlay-msg{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    flex-direction:column; gap:12px; padding:24px; text-align:center;
    background:rgba(14,20,27,0.92); color:var(--text-muted); font-size:14px;
  }

  .flash{
    border-radius:var(--radius-md); padding:12px 16px; font-size:14px; font-weight:700;
    display:flex; align-items:center; gap:10px; min-height:20px;
  }
  .flash.ok{ background:rgba(74,222,128,0.14); color:var(--success); }
  .flash.dup{ background:rgba(251,191,36,0.14); color:var(--warn); }
  .flash.empty{ background:transparent; color:var(--text-muted); font-weight:500; }

  .row{ display:flex; gap:10px; }
  .row > *{ flex:1; }

  /* ---------- timer ---------- */
  .timer-screen{ align-items:center; text-align:center; padding-top:10vh; gap:26px; }
  .timer-screen .eyebrow{
    font-family:var(--font-mono); font-size:12px; letter-spacing:0.16em;
    text-transform:uppercase; color:var(--accent-strong);
  }
  .timer-ring{ position:relative; width:230px; height:230px; }
  .timer-ring svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .timer-ring circle{ fill:none; stroke-width:10; }
  .timer-ring .track{ stroke:var(--surface-2); }
  .timer-ring .fill{ stroke:var(--accent); stroke-linecap:round; transition:stroke-dashoffset 1s linear, stroke .3s ease; }
  .timer-digits{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-family:var(--font-mono); font-size:44px; font-weight:700; font-variant-numeric: tabular-nums;
  }
  .timer-ring.is-critical .fill{ stroke:var(--danger); }
  @media (prefers-reduced-motion: no-preference){ .timer-ring.is-critical{ animation: pulse 1s ease-in-out infinite; } }
  @keyframes pulse{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.045); } }
  .timer-caption{ color:var(--text-muted); font-size:14px; max-width:30ch; }

  /* ---------- reveal ---------- */
  .reveal-screen{ align-items:center; text-align:center; gap:20px; padding-top:4vh; }
  .reveal-frame{
    width:100%; border-radius:var(--radius-lg); overflow:hidden;
    border:1px solid var(--border); box-shadow:var(--shadow); background:var(--surface);
  }
  .reveal-frame img{ width:100%; display:block; max-height:60vh; object-fit:contain; background:var(--ink); }
  @media (prefers-reduced-motion: no-preference){ .reveal-frame{ animation: reveal-in .5s cubic-bezier(.2,.8,.2,1) both; } }
  @keyframes reveal-in{ from{ opacity:0; transform:scale(0.92); } to{ opacity:1; transform:scale(1); } }
  #confettiCanvas{ position:fixed; inset:0; pointer-events:none; z-index:50; }

  /* ---------- qr generator ---------- */
  .qr-sheet{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
  .qr-cell{
    position:relative; background:#fff; border-radius:var(--radius-sm);
    padding:10px; display:flex; flex-direction:column; align-items:center; gap:6px;
  }
  .qr-cell.is-inactive{ opacity:0.45; }
  .qr-cell canvas, .qr-cell img{ width:100% !important; height:auto !important; }
  .qr-cell span.qr-name{ font-family:var(--font-body); font-weight:700; font-size:12px; color:#0e141b; }
  .baja-badge{
    position:absolute; top:6px; right:6px; background:var(--danger); color:#2a0a0a;
    font-size:9px; font-weight:800; padding:2px 6px; border-radius:6px; letter-spacing:0.04em;
  }
  details.qr-panel{
    background:var(--surface-2); border:1px solid var(--border);
    border-radius:var(--radius-md); padding:14px;
  }
  details.qr-panel summary{ cursor:pointer; font-weight:700; font-size:14px; list-style:none; }
  details.qr-panel summary::-webkit-details-marker{ display:none; }
  details.qr-panel[open] summary{ margin-bottom:12px; }

  @media print{
    body *{ visibility:hidden; }
    #printArea, #printArea *{ visibility:visible; }
    #printArea{ position:absolute; inset:0; background:#fff; padding:24px; }
    .qr-cell{ break-inside:avoid; margin-bottom:14px; }
  }

  footer{ text-align:center; color:var(--text-muted); font-size:11px; padding:6px 20px 22px; }
</style>

<div class="app">
  <div class="topbar">
    <div class="brand">
      <span class="eyebrow">Escaneo &amp; sorpresa</span>
      <h1>La Cuenta Final</h1>
    </div>
    <button class="icon-btn" id="btnSettings" aria-label="Configuración" title="Configuración">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
    </button>
  </div>

  <main>
    <!-- SETUP -->
    <section class="screen" id="screen-setup">
      <div class="card">
        <h2>Jugadores</h2>
        <p class="hint">Esta es tu lista fija: cada jugador tiene siempre el mismo código QR. Si alguien abandona el juego, apagá su interruptor — su código deja de contar y de validar, sin borrar sus datos.</p>
        <div id="rosterList"></div>
        <div class="add-player">
          <input type="text" id="inputNewPlayer" placeholder="Agregar jugador...">
          <button class="btn btn-ghost btn-sm" id="btnAddPlayer" type="button">Agregar</button>
        </div>
      </div>

      <div class="card">
        <h2>Fotos sorpresa</h2>
        <p class="hint">Ya están cargadas las 12. Se muestran en orden, una por ronda — tocá una miniatura para elegir cuál sigue.</p>
        <div class="photo-strip" id="photoStrip"></div>
      </div>

      <button class="btn btn-primary btn-block" id="btnSaveSetup">Listo, ir a escanear</button>
      <p class="hint" id="setupError" style="color:var(--danger); display:none;"></p>

      <details class="qr-panel" id="qrPanel">
        <summary>Ver / imprimir los códigos QR de cada jugador →</summary>
        <p class="hint">Cada código es fijo: se genera a partir del nombre, así que podés imprimirlo una sola vez y reusarlo en cada ronda. Los jugadores dados de baja aparecen marcados — no los repartas.</p>
        <div class="row" style="margin-top:10px;">
          <button class="btn btn-ghost btn-sm" id="btnRefreshQr" type="button">Actualizar</button>
          <button class="btn btn-ghost btn-sm" id="btnPrintQr" type="button">Imprimir</button>
        </div>
        <p class="hint" id="qrLibWarning" style="display:none; color:var(--warn);">No se pudo cargar el generador de QR en este momento. Probá de nuevo en unos segundos con "Actualizar".</p>
        <div id="printArea">
          <div class="qr-sheet" id="qrSheet" style="margin-top:14px;"></div>
        </div>
      </details>
    </section>

    <!-- SCAN -->
    <section class="screen" id="screen-scan">
      <div class="progress-head">
        <span class="progress-count"><b id="scanCount">0</b> / <span id="scanTotal">0</span> escaneados</span>
      </div>
      <div class="chip-wrap" id="chipWrap"></div>
      <p class="hint" id="inactiveNote" style="display:none;"></p>

      <div class="scan-stage">
        <video id="video" playsinline muted></video>
        <div class="scan-frame"></div>
        <div class="scan-line"></div>
        <div class="scan-overlay-msg" id="scanOverlayMsg">
          <span>Apuntá la cámara al QR de cada jugador</span>
          <button class="btn btn-primary" id="btnStartCamera">Activar cámara</button>
        </div>
      </div>
      <canvas id="canvas" style="display:none;"></canvas>

      <div class="flash empty" id="flashMsg">Listo para escanear</div>

      <p class="hint">¿La cámara no anda con un código puntual? Tocá el nombre en la lista de arriba para marcarlo a mano (y volvé a tocarlo si te equivocaste).</p>
      <div class="field">
        <label for="inputFileScan">O subí una foto del código</label>
        <input type="file" id="inputFileScan" accept="image/*">
      </div>
    </section>

    <!-- TIMER -->
    <section class="screen timer-screen" id="screen-timer">
      <span class="eyebrow">¡Todos escaneados!</span>
      <div class="timer-ring" id="timerRing">
        <svg viewBox="0 0 120 120">
          <circle class="track" cx="60" cy="60" r="52"></circle>
          <circle class="fill" id="timerFillCircle" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="0"></circle>
        </svg>
        <div class="timer-digits" id="timerDigits">03:00</div>
      </div>
      <p class="timer-caption">La sorpresa se revela apenas termine la cuenta regresiva. No cierres esta pantalla.</p>
    </section>

    <!-- REVEAL -->
    <section class="screen reveal-screen" id="screen-reveal">
      <span class="eyebrow" style="font-family:var(--font-mono); font-size:12px; letter-spacing:0.16em; text-transform:uppercase; color:var(--accent-strong);">¡Tiempo cumplido!</span>
      <h2 style="font-size:24px;">La sorpresa</h2>
      <div class="reveal-frame">
        <img id="revealImg" alt="Foto sorpresa" src="">
      </div>
      <div class="row">
        <button class="btn btn-primary" id="btnNewRound">Jugar otra ronda</button>
        <button class="btn btn-ghost" id="btnEditFromReveal">Configuración</button>
      </div>
    </section>
  </main>

  <footer>Se guarda solo en este celular · pensado para usar con una sola cámara</footer>
</div>

<canvas id="confettiCanvas"></canvas>

<script>
(function(){
  "use strict";

  var PHOTOS = [
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,",
    "data:image/jpeg;base64,"
  ];

  var STORAGE_KEY = "cuentaFinal.v2";
  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var DEFAULT_NAMES = ["Martu","Benja","Juan","Paz","Rochi","Mily","Maggie","Tere","Panchi","Tini","Juani","Simón","Chinu","Rafa","Tomy","Juampi"];

  function slugify(name){
    return String(name)
      .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
      .toLowerCase()
      .replace(/[^a-z0-9]+/g,'-')
      .replace(/(^-+|-+$)/g,'') || 'jugador';
  }
  function makeId(name, existingIds){
    var base = slugify(name);
    var id = base, n = 2;
    while(existingIds.indexOf(id) !== -1){ id = base + '-' + n; n++; }
    return id;
  }
  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function defaultRoster(){
    var ids = [];
    return DEFAULT_NAMES.map(function(name){
      var id = makeId(name, ids); ids.push(id);
      return { id:id, name:name, active:true };
    });
  }

  function loadState(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      if(raw){
        var s = JSON.parse(raw);
        if(s && Array.isArray(s.roster)){
          if(typeof s.photoIndex !== 'number') s.photoIndex = 0;
          delete s.photo;
          return s;
        }
      }
    }catch(e){}
    return { roster: defaultRoster(), scanned:[], photo:null, photoIndex:0, timerEndAt:null };
  }
  function saveState(){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch(e){} }

  var state = loadState();

  // ---------- element refs ----------
  var screens = {
    setup: document.getElementById('screen-setup'),
    scan: document.getElementById('screen-scan'),
    timer: document.getElementById('screen-timer'),
    reveal: document.getElementById('screen-reveal')
  };
  var rosterList = document.getElementById('rosterList');
  var inputNewPlayer = document.getElementById('inputNewPlayer');
  var btnAddPlayer = document.getElementById('btnAddPlayer');
  var photoStrip = document.getElementById('photoStrip');
  var btnSaveSetup = document.getElementById('btnSaveSetup');
  var setupError = document.getElementById('setupError');
  var btnSettings = document.getElementById('btnSettings');

  var scanCountEl = document.getElementById('scanCount');
  var scanTotalEl = document.getElementById('scanTotal');
  var chipWrap = document.getElementById('chipWrap');
  var inactiveNote = document.getElementById('inactiveNote');
  var flashMsg = document.getElementById('flashMsg');
  var btnStartCamera = document.getElementById('btnStartCamera');
  var scanOverlayMsg = document.getElementById('scanOverlayMsg');
  var video = document.getElementById('video');
  var canvas = document.getElementById('canvas');
  var ctx = canvas.getContext('2d', { willReadFrequently:true });
  var inputFileScan = document.getElementById('inputFileScan');

  var timerDigits = document.getElementById('timerDigits');
  var timerRing = document.getElementById('timerRing');
  var timerFillCircle = document.getElementById('timerFillCircle');
  var revealImg = document.getElementById('revealImg');
  var btnNewRound = document.getElementById('btnNewRound');
  var btnEditFromReveal = document.getElementById('btnEditFromReveal');

  var qrPanel = document.getElementById('qrPanel');
  var btnRefreshQr = document.getElementById('btnRefreshQr');
  var btnPrintQr = document.getElementById('btnPrintQr');
  var qrSheet = document.getElementById('qrSheet');
  var qrLibWarning = document.getElementById('qrLibWarning');

  var CIRCUMFERENCE = 2 * Math.PI * 52;

  // ---------- roster helpers ----------
  function activePlayers(){ return state.roster.filter(function(p){ return p.active; }); }
  function doneActiveCount(){
    var act = activePlayers();
    return act.filter(function(p){ return state.scanned.indexOf(p.id) !== -1; }).length;
  }
  function tokenFor(id){ return 'jugador:' + id; }
  function findByToken(code){
    var trimmed = (code || '').trim();
    return state.roster.filter(function(p){ return tokenFor(p.id) === trimmed; })[0] || null;
  }
  function checkCompletion(){
    var act = activePlayers();
    if(act.length > 0 && doneActiveCount() >= act.length && !state.timerEndAt){
      state.timerEndAt = Date.now() + 3*60*1000;
      saveState();
      return true;
    }
    return false;
  }

  // ---------- screen routing ----------
  var scanLoopId = null;
  var stream = null;
  var timerInterval = null;
  var lastFlashCode = null;
  var lastFlashAt = 0;

  function currentScreen(){
    if(activePlayers().length === 0) return 'setup';
    if(state.timerEndAt) return Date.now() < state.timerEndAt ? 'timer' : 'reveal';
    if(doneActiveCount() >= activePlayers().length) return 'reveal';
    return 'scan';
  }

  function showScreen(name){
    Object.keys(screens).forEach(function(k){ screens[k].classList.toggle('is-active', k === name); });
    if(name !== 'scan') stopCamera();
    if(name === 'scan') renderScan();
    if(name === 'timer') startTimerLoop(); else stopTimerLoop();
    if(name === 'reveal') renderReveal();
  }
  function route(){ showScreen(currentScreen()); }

  // ---------- setup: roster editor ----------
  function renderRoster(){
    rosterList.innerHTML = '';
    state.roster.forEach(function(p){
      var row = document.createElement('div');
      row.className = 'roster-row';
      row.innerHTML =
        '<span class="roster-name' + (p.active ? '' : ' is-inactive') + '">' + escapeHtml(p.name) + '</span>' +
        '<div class="roster-actions">' +
          '<span class="roster-status">' + (p.active ? 'Activo' : 'De baja') + '</span>' +
          '<label class="switch">' +
            '<input type="checkbox" ' + (p.active ? 'checked' : '') + ' data-id="' + p.id + '">' +
            '<span class="switch-track"><span class="switch-thumb"></span></span>' +
          '</label>' +
          '<button class="roster-remove" data-remove="' + p.id + '" type="button" aria-label="Quitar jugador">&times;</button>' +
        '</div>';
      rosterList.appendChild(row);
    });
    rosterList.querySelectorAll('input[type="checkbox"]').forEach(function(chk){
      chk.addEventListener('change', function(){
        var p = state.roster.filter(function(x){ return x.id === chk.dataset.id; })[0];
        if(p){ p.active = chk.checked; saveState(); checkCompletion(); renderRoster(); maybeRefreshQrSheet(); }
      });
    });
    rosterList.querySelectorAll('[data-remove]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.dataset.remove;
        state.roster = state.roster.filter(function(x){ return x.id !== id; });
        state.scanned = state.scanned.filter(function(sid){ return sid !== id; });
        saveState(); renderRoster(); maybeRefreshQrSheet();
      });
    });
  }

  btnAddPlayer.addEventListener('click', function(){
    var name = inputNewPlayer.value.trim();
    if(!name) return;
    var id = makeId(name, state.roster.map(function(p){ return p.id; }));
    state.roster.push({ id:id, name:name, active:true });
    saveState();
    inputNewPlayer.value = '';
    renderRoster();
    maybeRefreshQrSheet();
  });
  inputNewPlayer.addEventListener('keydown', function(e){
    if(e.key === 'Enter'){ e.preventDefault(); btnAddPlayer.click(); }
  });

  function renderSetup(){
    renderRoster();
    renderPhotoStrip();
  }

  function renderPhotoStrip(){
    photoStrip.innerHTML = '';
    PHOTOS.forEach(function(src, i){
      var img = document.createElement('img');
      img.src = src;
      img.alt = 'Foto ' + (i + 1);
      img.className = 'photo-thumb' + (i === state.photoIndex ? ' is-current' : '');
      img.addEventListener('click', function(){
        state.photoIndex = i;
        saveState();
        renderPhotoStrip();
      });
      photoStrip.appendChild(img);
    });
  }

  btnSaveSetup.addEventListener('click', function(){
    setupError.style.display = 'none';
    if(activePlayers().length < 1){
      setupError.textContent = 'Activá al menos un jugador.';
      setupError.style.display = 'block';
      return;
    }
    saveState();
    route();
  });

  btnSettings.addEventListener('click', function(){ renderSetup(); showScreen('setup'); });
  btnEditFromReveal.addEventListener('click', function(){ renderSetup(); showScreen('setup'); });

  // ---------- QR generator (best-effort; app works fine without it) ----------
  function qrLibAvailable(){ return typeof window.QRCode === 'function'; }

  function renderQrSheet(){
    qrSheet.innerHTML = '';
    if(!qrLibAvailable()){ qrLibWarning.style.display = 'block'; return; }
    qrLibWarning.style.display = 'none';
    state.roster.forEach(function(p){
      var cell = document.createElement('div');
      cell.className = 'qr-cell' + (p.active ? '' : ' is-inactive');
      if(!p.active){
        var badge = document.createElement('span');
        badge.className = 'baja-badge';
        badge.textContent = 'BAJA';
        cell.appendChild(badge);
      }
      var box = document.createElement('div');
      cell.appendChild(box);
      var label = document.createElement('span');
      label.className = 'qr-name';
      label.textContent = p.name;
      cell.appendChild(label);
      qrSheet.appendChild(cell);
      new window.QRCode(box, { text: tokenFor(p.id), width:128, height:128, correctLevel: window.QRCode.CorrectLevel.M });
    });
  }
  function maybeRefreshQrSheet(){ if(qrPanel.open) renderQrSheet(); }

  qrPanel.addEventListener('toggle', function(){ if(qrPanel.open) renderQrSheet(); });
  btnRefreshQr.addEventListener('click', renderQrSheet);
  btnPrintQr.addEventListener('click', function(){
    renderQrSheet();
    setTimeout(function(){ window.print(); }, 50);
  });

  // ---------- scan screen ----------
  function renderScan(){
    var act = activePlayers();
    scanCountEl.textContent = doneActiveCount();
    scanTotalEl.textContent = act.length;

    chipWrap.innerHTML = '';
    act.forEach(function(p){
      var done = state.scanned.indexOf(p.id) !== -1;
      var chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'chip ' + (done ? 'is-done' : 'is-pending');
      chip.textContent = (done ? '✓ ' : '') + p.name;
      chip.addEventListener('click', function(){ toggleManual(p.id); });
      chipWrap.appendChild(chip);
    });

    var inactiveCount = state.roster.length - act.length;
    if(inactiveCount > 0){
      inactiveNote.style.display = 'block';
      inactiveNote.textContent = inactiveCount === 1
        ? '1 jugador de baja no cuenta para la cuenta regresiva.'
        : inactiveCount + ' jugadores de baja no cuentan para la cuenta regresiva.';
    } else {
      inactiveNote.style.display = 'none';
    }
  }

  function flash(kind, text){
    flashMsg.className = 'flash ' + kind;
    flashMsg.textContent = text;
  }

  function toggleManual(id){
    var idx = state.scanned.indexOf(id);
    var player = state.roster.filter(function(p){ return p.id === id; })[0];
    if(idx !== -1){
      state.scanned.splice(idx, 1);
      saveState();
      flash('dup', (player ? player.name : 'Jugador') + ' desmarcado');
      renderScan();
      return;
    }
    state.scanned.push(id);
    saveState();
    flash('ok', '✓ Sumado a mano — ' + (player ? player.name : id));
    if(navigator.vibrate){ try{ navigator.vibrate(60); }catch(e){} }
    renderScan();
    if(checkCompletion()) setTimeout(route, 500);
  }

  function registerCode(code){
    if(!code) return;
    var now = Date.now();
    var player = findByToken(code);

    if(!player){
      if(code !== lastFlashCode || now - lastFlashAt > 1500){
        flash('dup', 'Código no reconocido en esta lista');
        lastFlashCode = code; lastFlashAt = now;
      }
      return;
    }
    if(!player.active){
      if(code !== lastFlashCode || now - lastFlashAt > 1500){
        flash('dup', player.name + ' está de baja — no cuenta');
        lastFlashCode = code; lastFlashAt = now;
      }
      return;
    }
    var isDuplicate = state.scanned.indexOf(player.id) !== -1;
    if(isDuplicate){
      if(code !== lastFlashCode || now - lastFlashAt > 1500){
        flash('dup', 'Ya estaba escaneado — ' + player.name);
        lastFlashCode = code; lastFlashAt = now;
      }
      return;
    }
    state.scanned.push(player.id);
    saveState();
    flash('ok', '✓ Sumado — ' + player.name + ' (' + doneActiveCount() + '/' + activePlayers().length + ')');
    lastFlashCode = code; lastFlashAt = now;
    if(navigator.vibrate){ try{ navigator.vibrate(60); }catch(e){} }
    renderScan();
    if(checkCompletion()) setTimeout(route, 500);
  }

  function startCamera(){
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      flash('dup', 'Este navegador no permite usar la cámara acá.');
      return;
    }
    navigator.mediaDevices.getUserMedia({ video:{ facingMode:{ ideal:'environment' } }, audio:false })
      .then(function(s){
        stream = s;
        video.srcObject = s;
        video.play();
        scanOverlayMsg.style.display = 'none';
        scanLoopId = requestAnimationFrame(scanTick);
      })
      .catch(function(err){
        var name = err && err.name ? err.name : 'error';
        var msg;
        if(name === 'NotAllowedError' || name === 'PermissionDeniedError'){
          msg = 'La cámara está bloqueada para esta página. Si la abriste dentro de otra app (WhatsApp, Instagram, o la vista previa del chat), tocá "Abrir en el navegador" y volvé a intentar ahí. Si ya la abriste en Chrome o Safari, revisá los permisos de cámara del sitio (ícono de candado o "aA" junto a la dirección) y elegí "Permitir".';
        } else if(name === 'NotFoundError' || name === 'DevicesNotFoundError'){
          msg = 'No se encontró ninguna cámara en este dispositivo.';
        } else if(name === 'NotReadableError' || name === 'TrackStartError'){
          msg = 'La cámara está siendo usada por otra app. Cerrala e intentá de nuevo.';
        } else {
          msg = 'No se pudo abrir la cámara (' + name + ').';
        }
        scanOverlayMsg.innerHTML = '<span>' + msg + ' Mientras tanto podés tocar un nombre en la lista para marcarlo a mano.</span><button class="btn btn-ghost" id="btnRetryCamera" type="button" style="margin-top:4px;">Reintentar</button>';
        var retryBtn = document.getElementById('btnRetryCamera');
        if(retryBtn) retryBtn.addEventListener('click', startCamera);
      });
  }
  btnStartCamera.addEventListener('click', startCamera);

  function stopCamera(){
    if(scanLoopId){ cancelAnimationFrame(scanLoopId); scanLoopId = null; }
    if(stream){ stream.getTracks().forEach(function(t){ t.stop(); }); stream = null; }
  }

  function scanTick(){
    if(video.readyState === video.HAVE_ENOUGH_DATA && typeof jsQR === 'function'){
      var w = video.videoWidth, h = video.videoHeight;
      if(w && h){
        var scale = Math.min(1, 480 / w);
        canvas.width = Math.round(w * scale);
        canvas.height = Math.round(h * scale);
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        var imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        var code = jsQR(imgData.data, imgData.width, imgData.height);
        if(code && code.data) registerCode(code.data);
      }
    }
    scanLoopId = requestAnimationFrame(scanTick);
  }

  inputFileScan.addEventListener('change', function(){
    var f = inputFileScan.files && inputFileScan.files[0];
    if(!f || typeof jsQR !== 'function') return;
    var reader = new FileReader();
    reader.onload = function(e){
      var img = new Image();
      img.onload = function(){
        var c = document.createElement('canvas');
        c.width = img.width; c.height = img.height;
        var cctx = c.getContext('2d');
        cctx.drawImage(img, 0, 0);
        var data = cctx.getImageData(0, 0, c.width, c.height);
        var code = jsQR(data.data, data.width, data.height);
        if(code && code.data){ registerCode(code.data); }
        else{ flash('dup', 'No se detectó ningún QR en esa imagen.'); }
        inputFileScan.value = '';
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(f);
  });

  // ---------- timer screen ----------
  function startTimerLoop(){
    stopTimerLoop();
    updateTimerDisplay();
    timerInterval = setInterval(function(){
      if(Date.now() >= state.timerEndAt){
        stopTimerLoop();
        state.timerEndAt = null;
        saveState();
        route();
        return;
      }
      updateTimerDisplay();
    }, 250);
  }
  function stopTimerLoop(){ if(timerInterval){ clearInterval(timerInterval); timerInterval = null; } }
  function updateTimerDisplay(){
    var remainingMs = Math.max(0, state.timerEndAt - Date.now());
    var totalSec = Math.ceil(remainingMs / 1000);
    var mm = Math.floor(totalSec / 60);
    var ss = totalSec % 60;
    timerDigits.textContent = String(mm).padStart(2,'0') + ':' + String(ss).padStart(2,'0');
    var frac = remainingMs / (3*60*1000);
    timerFillCircle.style.strokeDashoffset = String(CIRCUMFERENCE * (1 - frac));
    timerRing.classList.toggle('is-critical', totalSec <= 10);
  }

  // ---------- reveal screen ----------
  function renderReveal(){
    revealImg.src = PHOTOS[state.photoIndex % PHOTOS.length];
    launchConfetti();
  }

  btnNewRound.addEventListener('click', function(){
    state.scanned = [];
    state.timerEndAt = null;
    state.photoIndex = (state.photoIndex + 1) % PHOTOS.length;
    saveState();
    route();
  });

  // ---------- confetti (hand-rolled, respects reduced motion) ----------
  var confettiCanvas = document.getElementById('confettiCanvas');
  function launchConfetti(){
    if(reduceMotion) return;
    var cctx = confettiCanvas.getContext('2d');
    var W = confettiCanvas.width = window.innerWidth;
    var H = confettiCanvas.height = window.innerHeight;
    var colors = ['#ff7a45', '#ffa06e', '#4ade80', '#fbbf24', '#eef3f7'];
    var particles = [];
    for(var i=0;i<90;i++){
      particles.push({
        x: W/2 + (Math.random()-0.5)*40,
        y: H*0.3,
        vx: (Math.random()-0.5)*9,
        vy: -Math.random()*9 - 3,
        size: 4 + Math.random()*4,
        color: colors[Math.floor(Math.random()*colors.length)],
        rot: Math.random()*Math.PI,
        vr: (Math.random()-0.5)*0.3
      });
    }
    var start = performance.now();
    function frame(t){
      var elapsed = t - start;
      cctx.clearRect(0,0,W,H);
      particles.forEach(function(p){
        p.vy += 0.22;
        p.x += p.vx; p.y += p.vy; p.rot += p.vr;
        cctx.save();
        cctx.translate(p.x, p.y);
        cctx.rotate(p.rot);
        cctx.fillStyle = p.color;
        cctx.fillRect(-p.size/2, -p.size/2, p.size, p.size);
        cctx.restore();
      });
      if(elapsed < 2600){ requestAnimationFrame(frame); }
      else{ cctx.clearRect(0,0,W,H); }
    }
    requestAnimationFrame(frame);
  }

  // ---------- boot ----------
  renderSetup();
  route();
})();
</script>
